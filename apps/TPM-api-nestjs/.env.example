# ═══════════════════════════════════════════════════════════════════════════════
# PROMO MASTER V3 - ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# App
NODE_ENV=development
PORT=3010

# Database
DATABASE_URL="postgresql://postgres:postgrespostgresql://postgres:postgres@localhost:15432/promo_master?schema=public"

# Redis
REDIS_URL=redis://localhost:16379

# JWT Authentication
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# CORS
CORS_ORIGINS=http://localhost:3019,http://localhost:3011,http://localhost:3013

# File Storage (S3/MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lerp-files-tpm
S3_REGION=us-east-1

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
